// Prisma Schema for URL Shortener with Analytics
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model URL {
  id            Int      @id @default(autoincrement())
  originalUrl   String   @db.Text
  shortCode     String   @unique
  clicks        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clicksRecord  Click[]  @relation("ClickOnURL")
  
  @@index([shortCode])
  @@index([createdAt])
}

model Click {
  id          Int      @id @default(autoincrement())
  urlId       Int
  url         URL      @relation("ClickOnURL", fields: [urlId], references: [id])
  timestamp   DateTime @default(now())
  referrer    String?
  userAgent   String?
  country     String?
  device      String?
  
  @@index([urlId, timestamp])
  @@index([timestamp])
}